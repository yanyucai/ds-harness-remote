{
  "compilerOptions": {
    "target": "ES2022", "module": "ESNext", "moduleResolution": "Bundler",
    "strict": true, "skipLibCheck": true, "esModuleInterop": true, "resolveJsonModule": true,
    "lib": ["ES2022", "DOM"], "types": ["node"],
    "paths": {
      "@dsh-remote/crypto": ["../../packages/crypto/src/index.ts"],
      "@dsh-remote/protocol": ["../../packages/protocol/src/index.ts"],
      "@dsh-remote/client-core": ["../../packages/client-core/src/index.ts"],
      "@dsh-remote/webrtc": ["../../packages/webrtc/src/index.ts"]
    }
  },
  "include": ["core/**/*.ts"]
}
